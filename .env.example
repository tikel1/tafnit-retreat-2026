# Tafnit Retreat 2026 — environment variables
#
# Copy to `.env.local` for local dev. Never commit real keys.
#
# Tip: put VITE_GEMINI_API_KEY in `.env.development.local` only (dev server).
# `.env.local` is loaded for production builds too — a key there can leak into
# dist/ unless you use VITE_GEMINI_PROXY_URL (see vite.config.ts).

# ----------------------------------------------------------------------
# VITE_GEMINI_PROXY_URL  (recommended for production)
# ----------------------------------------------------------------------
# Public URL of the Cloudflare Worker in `worker/`.
# Example: https://tafnit-gemini-proxy.<account>.workers.dev/gemini
#
# The Gemini API key lives only on the worker (GEMINI_API_KEY secret).
# It is NOT baked into the browser bundle.

VITE_GEMINI_PROXY_URL=

# ----------------------------------------------------------------------
# VITE_GEMINI_API_KEY  (local dev fallback only)
# ----------------------------------------------------------------------
# Direct client-side key — gets embedded in the JS bundle. Do NOT use for
# GitHub Pages production. Restrict by HTTP referrer if you must use it locally.

VITE_GEMINI_API_KEY=
